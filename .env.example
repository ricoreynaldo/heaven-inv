# Salin menjadi .env lalu isi nilainya.

# --- Database dummy (dipakai sekarang) ---------------------------------------
# File JSON tempat data katalog/admin disimpan selama backend belum siap.
DUMMY_DB_PATH=".data/db.json"

# --- Database Postgres (nanti, belum dipakai) ---------------------------------
# Postgres apa pun (Neon, Supabase, RDS, lokal). Untuk dev tanpa Postgres,
# jalankan `npm run db:local` dan pakai URL contoh di bawah.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/heaven_inv?sslmode=disable"

# --- Auth (wajib) -----------------------------------------------------------
# Minimal 32 karakter acak. Contoh membuat: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
AUTH_SECRET=""

# --- Situs -------------------------------------------------------------------
# URL publik tanpa garis miring di akhir. Di Vercel boleh dikosongkan
# (otomatis memakai VERCEL_PROJECT_PRODUCTION_URL).
SITE_URL="http://localhost:3060"

# --- Seed admin (dipakai `npm run db:seed` / `npm run admin:create`) ----------
SEED_ADMIN_EMAIL="admin@heaveninv.id"
SEED_ADMIN_PASSWORD=""

# --- Storage media ----------------------------------------------------------
# "local"       → file disimpan di STORAGE_LOCAL_DIR dan disajikan lewat /media/*
#                 (cocok untuk VPS / server dengan disk permanen).
# "vercel-blob" → Vercel Blob (wajib di Vercel/serverless; filesystem-nya tidak permanen).
# Jika kosong: otomatis "vercel-blob" bila BLOB_READ_WRITE_TOKEN tersedia.
STORAGE_DRIVER=""
STORAGE_LOCAL_DIR="./storage/uploads"
BLOB_READ_WRITE_TOKEN=""
# Vercel menolak body > 4,5 MB, jadi default 4.
MAX_UPLOAD_MB=4

# --- Rate limit (opsional, disarankan di serverless) ------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
